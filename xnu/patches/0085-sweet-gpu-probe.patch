+static int
+rh_lookup_arc(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+	unsigned i = 0, j = 0;
+
+	for (i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		uint32_t entries = 0, aux = 0;
+		unsigned count = 0;
+
+		if (!slave) {
+			break;
+		}
+		if (slave != 3u) {
+			continue;
+		}
+		entries = RH_DB_HEADER + rh_db16(h + 2);
+		aux = RH_DB_HEADER + rh_db16(h + 4);
+		count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed ARC slave header %u\n", i);
+			return EINVAL;
+		}
+		for (j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			uint32_t addr = 0;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			addr = rh_read(rh_db, e + 16);
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: ARC %s addr=0x%08x slave=%u\n", res, addr, slave);
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: ARC %s lookup matches=%u\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static int
+rh_send_arc(uint32_t address, uint32_t level)
+{
+	int chosen = -1;
+	unsigned t = 0, us = 0;
+	uint32_t b = 0, bit = 0, irq_en = 0, cmd = 0, status = 0;
+	bool done = false;
+
+	for (t = 0; t < RH_ACTIVE_N; ++t) {
+		if (rh_free(t)) {
+			chosen = (int)t;
+			break;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS for ARC\n");
+		return EBUSY;
+	}
+	t = (unsigned)chosen;
+	b = t * RH_TCS_STRIDE;
+	bit = 1u << t;
+	irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	rh_poisoned = true;
+	printf("SWEET RPMH: TCS%u ARC addr=0x%08x level=%u\n", t, address, level);
+	cmd = b;
+	if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+	    !rh_sync(cmd + RH_ADDR, address) ||
+	    !rh_sync(cmd + RH_DATA, level)) {
+		return EIO;
+	}
+	if (!rh_sync(b + RH_WAIT, 1) || !rh_sync(b + RH_ENABLE, 1) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	for (us = 0; us < RH_TIMEOUT_US; ++us) {
+		status = rh_read(rh_tcs, b + RH_CMD_STATUS);
+		if (status != 0xffffffffu &&
+		    (status & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done) {
+		printf("SWEET RPMH: ARC timeout addr=0x%08x status=0x%08x\n", address, status);
+		return ETIMEDOUT;
+	}
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: ARC vote complete\n");
+	return 0;
+}
+
+int
+sweet_rpmh_arc_vote(const char *res, uint32_t level)
+{
+	int error = EIO;
+	uint32_t address = 0;
+
+	if (!res || level > 512) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_arc(res, &address);
+	}
+	if (!error) {
+		error = rh_send_arc(address, level);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: arc vote %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 int
 sweet_rpmh_vreg_enable(const char *res, unsigned mv)
 {
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,276 @@
+/*
+ * SWEET: Qualcomm Adreno 618 GPU bring-up probe for Samsung Galaxy A71 (SM7150).
+ *
+ * Votes RPMh voltage rails (cx.lvl, mx.lvl, gfx.lvl), enables GCC bus clocks,
+ * enables GPUCC AHB branch, powers up CX GDSC, enables GMU clocks, pulses GMEM
+ * reset and removes I/O clamp, enables SPTPRAC power in GMU, verifies GX GDSC,
+ * enables GFX3D core clock, and safely reads Adreno 618 RBBM / CP registers.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int);
+extern int sweet_rpmh_arc_vote(const char *res, uint32_t level);
+void sweet_gpu_probe(void);
+
+#define GCC_PA                  0x00100000u
+#define GCC_SIZE                0x00090000u
+#define GCC_GPU_CFG_AHB_CBCR    0x71004u    /* AHB clock to GPUCC */
+#define GCC_GPU_MEMNOC_GFX_CBCR 0x7100cu    /* MemNOC GFX clock (BRANCH_VOTED) */
+
+#define GPUCC_PA                0x05090000u
+#define GPUCC_SIZE              0x00009000u
+#define GPUCC_GPU_GX_GDSCR      0x100cu     /* GX domain power switch */
+#define GPUCC_GPU_CX_GDSCR      0x106cu     /* CX domain power switch */
+#define GPUCC_GX_GFX3D_CMD_RCGR 0x101cu     /* GFX3D root clock RCG command */
+#define GPUCC_GX_SW_RESET       0x1008u     /* GX AON logic reset */
+#define GPUCC_GX_GFX3D_CBCR     0x1054u     /* 3D core clock branch (BRANCH_HALT_SKIP) */
+#define GPUCC_AHB_CBCR          0x1078u     /* GPU AHB clock branch (BRANCH_HALT_DELAY) */
+#define GPUCC_CX_GMU_CBCR       0x1098u     /* GMU branch clock */
+#define GPUCC_GMU_CMD_RCGR      0x1120u     /* GMU root clock RCG command */
+#define GPUCC_CLAMP_IO_CTRL     0x1508u     /* I/O clamp & GMEM reset control */
+
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define GDSC_PWR_ON             (1u << 31)
+#define GDSC_PWR_UP_DONE        (1u << 16)
+#define CBCR_CLK_OFF            (1u << 31)
+#define CBCR_ENABLE             (1u << 0)
+#define RCG_ROOT_EN             (1u << 1)
+
+#define GMU_PA                  0x0506a000u
+#define GMU_SIZE                0x00030000u /* 192 KB GMU address space */
+#define GMU_GX_SPTPRAC_POWER_CONTROL  (0x81u << 2)   /* 0x0204 */
+#define GMU_SPTPRAC_PWR_CLK_STATUS    (0x50d0u << 2) /* 0x14340 */
+#define SPTPRAC_POWER_ON_VAL    0x778000u
+#define SPTPRAC_STATUS_MASK     0x38u
+#define SPTPRAC_STATUS_READY    0x28u
+
+#define KGSL_3D0_PA             0x05000000u
+#define KGSL_3D0_SIZE           0x00040000u
+
+/* Adreno 6xx RBBM & CP register byte offsets (dwords << 2) */
+#define A6XX_RBBM_STATUS              (0x210u << 2) /* 0x0840 */
+#define A6XX_RBBM_STATUS3             (0x213u << 2) /* 0x084c */
+#define A6XX_RBBM_VBIF_GX_RESET_STATUS (0x215u << 2) /* 0x0854 */
+#define A6XX_CP_RB_BASE               (0x800u << 2) /* 0x2000 */
+
+static inline uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+}
+
+static bool
+gpu_poll_gdsc_on(vm_offset_t gpucc, uint32_t gdscr_off, const char *name)
+{
+	unsigned i = 0;
+	uint32_t v = 0;
+
+	for (i = 0; i < 2000; ++i) {
+		v = gpu_rd(gpucc, gdscr_off);
+		if (v & (GDSC_PWR_ON | GDSC_PWR_UP_DONE)) {
+			return true;
+		}
+		delay(5);
+	}
+	printf("SWEET GPU: %s GDSC power-on timed out (0x%08x)\n", name, gpu_rd(gpucc, gdscr_off));
+	return false;
+}
+
+static bool
+gpu_poll_clk_on(vm_offset_t base, uint32_t cbcr_off, const char *name)
+{
+	unsigned i = 0;
+	uint32_t v = 0;
+
+	for (i = 0; i < 2000; ++i) {
+		v = gpu_rd(base, cbcr_off);
+		if (!(v & CBCR_CLK_OFF)) {
+			return true;
+		}
+		delay(5);
+	}
+	printf("SWEET GPU: %s clock enable timed out (0x%08x)\n", name, gpu_rd(base, cbcr_off));
+	return false;
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int enabled = 1;
+	vm_offset_t gcc = 0, gpucc = 0, kgsl = 0, gmu = 0;
+	uint32_t gcc_ahb = 0, gcc_memnoc = 0;
+	uint32_t cx_gdscr = 0, gx_gdscr = 0;
+	uint32_t gfx_cbcr = 0, gmu_rcgr = 0, gmu_cbcr = 0;
+	uint32_t clamp_val = 0, sptprac_status = 0;
+	uint32_t final_gx = 0, final_gfx_clk = 0;
+	uint32_t rbbm_status = 0, rbbm_status3 = 0, vbif_reset = 0, cp_rb_base = 0;
+	int arc_cx = 0, arc_mx = 0, arc_gfx = 0;
+	int timeout = 0;
+
+	PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET GPU: disabled by sweetgpu=0\n");
+		return;
+	}
+
+	printf("SWEET GPU: probing Qualcomm Adreno 618 subsystem...\n");
+
+	/* 1. Vote RPMh voltage rails: cx.lvl, mx.lvl, gfx.lvl (128 = SVS level) */
+	arc_cx = sweet_rpmh_arc_vote("cx.lvl", 128);
+	arc_mx = sweet_rpmh_arc_vote("mx.lvl", 128);
+	arc_gfx = sweet_rpmh_arc_vote("gfx.lvl", 128);
+	printf("SWEET GPU: RPMh ARC votes: cx=%d mx=%d gfx=%d\n", arc_cx, arc_mx, arc_gfx);
+
+	/* 2. GCC clocks to GPU subsystem */
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("SWEET GPU: GCC map failed\n");
+		return;
+	}
+	gcc_ahb = gpu_rd(gcc, GCC_GPU_CFG_AHB_CBCR);
+	gcc_memnoc = gpu_rd(gcc, GCC_GPU_MEMNOC_GFX_CBCR);
+	printf("SWEET GPU: GCC AHB CBCR 0x%08x (%s), MemNOC CBCR 0x%08x (%s)\n",
+	    gcc_ahb, (gcc_ahb & CBCR_CLK_OFF) ? "off" : "on",
+	    gcc_memnoc, (gcc_memnoc & CBCR_CLK_OFF) ? "off" : "on");
+
+	/* Enable GCC AHB clock if off */
+	if (gcc_ahb & CBCR_CLK_OFF) {
+		gpu_wr(gcc, GCC_GPU_CFG_AHB_CBCR, gcc_ahb | CBCR_ENABLE);
+		gpu_poll_clk_on(gcc, GCC_GPU_CFG_AHB_CBCR, "GCC AHB");
+	}
+	/* Enable GCC MemNOC clock (BRANCH_VOTED: no halt polling) */
+	gpu_wr(gcc, GCC_GPU_MEMNOC_GFX_CBCR, gcc_memnoc | CBCR_ENABLE);
+	delay(20);
+
+	/* 3. Map GPUCC and enable GPU AHB clock branch (BRANCH_HALT_DELAY) */
+	gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (gpucc == 0) {
+		printf("SWEET GPU: GPUCC map failed\n");
+		return;
+	}
+
+	gpu_wr(gpucc, GPUCC_AHB_CBCR, CBCR_ENABLE);
+	delay(20);
+
+	cx_gdscr = gpu_rd(gpucc, GPUCC_GPU_CX_GDSCR);
+	gx_gdscr = gpu_rd(gpucc, GPUCC_GPU_GX_GDSCR);
+	gfx_cbcr = gpu_rd(gpucc, GPUCC_GX_GFX3D_CBCR);
+	gmu_rcgr = gpu_rd(gpucc, GPUCC_GMU_CMD_RCGR);
+	gmu_cbcr = gpu_rd(gpucc, GPUCC_CX_GMU_CBCR);
+
+	printf("SWEET GPU: initial GPUCC CX GDSC 0x%08x (%s), GX GDSC 0x%08x (%s)\n",
+	    cx_gdscr, (cx_gdscr & GDSC_PWR_ON) ? "ON" : "OFF",
+	    gx_gdscr, (gx_gdscr & GDSC_PWR_ON) ? "ON" : "OFF");
+	printf("SWEET GPU: initial clocks: AHB 0x%08x, GFX3D 0x%08x, GMU branch 0x%08x\n",
+	    gpu_rd(gpucc, GPUCC_AHB_CBCR), gfx_cbcr, gmu_cbcr);
+
+	/* 4. Power on CX GDSC (powers GPUCC CX domain and GMU) */
+	if (!(cx_gdscr & GDSC_PWR_ON)) {
+		printf("SWEET GPU: powering on CX GDSC...\n");
+		gpu_wr(gpucc, GPUCC_GPU_CX_GDSCR, cx_gdscr & ~GDSC_SW_COLLAPSE);
+		gpu_poll_gdsc_on(gpucc, GPUCC_GPU_CX_GDSCR, "CX");
+	}
+
+	/* 5. Enable GMU root and branch clocks */
+	printf("SWEET GPU: enabling GMU clocks (RCGR 0x1120, CBCR 0x1098)...\n");
+	gpu_wr(gpucc, GPUCC_GMU_CMD_RCGR, gpu_rd(gpucc, GPUCC_GMU_CMD_RCGR) | RCG_ROOT_EN);
+	delay(20);
+	gpu_wr(gpucc, GPUCC_CX_GMU_CBCR, CBCR_ENABLE);
+	delay(20);
+	gpu_poll_clk_on(gpucc, GPUCC_CX_GMU_CBCR, "GPUCC CX GMU");
+
+	/* 6. I/O Clamp & GMEM Reset (0x1508) */
+	clamp_val = gpu_rd(gpucc, GPUCC_CLAMP_IO_CTRL);
+	printf("SWEET GPU: initial clamp_io_ctrl 0x%08x, pulsing GMEM reset...\n", clamp_val);
+	gpu_wr(gpucc, GPUCC_CLAMP_IO_CTRL, clamp_val | (1u << 4));
+	delay(10);
+	gpu_wr(gpucc, GPUCC_CLAMP_IO_CTRL, clamp_val & ~(1u << 4));
+	delay(10);
+	gpu_wr(gpucc, GPUCC_CLAMP_IO_CTRL, (clamp_val & ~(1u << 4)) & ~(1u << 0));
+	delay(10);
+	printf("SWEET GPU: clamp released: clamp_io_ctrl=0x%08x\n", gpu_rd(gpucc, GPUCC_CLAMP_IO_CTRL));
+
+	/* 7. GMU SPTPRAC Power Control (Shader / 3D core power gating) */
+	gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	if (gmu != 0) {
+		printf("SWEET GPU: GMU mapped at 0x%lx, writing SPTPRAC power control (0x%06x)...\n",
+		    (unsigned long)gmu, SPTPRAC_POWER_ON_VAL);
+		gpu_wr(gmu, GMU_GX_SPTPRAC_POWER_CONTROL, SPTPRAC_POWER_ON_VAL);
+
+		timeout = 5000;
+		while (timeout-- > 0) {
+			sptprac_status = gpu_rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS);
+			if ((sptprac_status & SPTPRAC_STATUS_MASK) == SPTPRAC_STATUS_READY) {
+				break;
+			}
+			delay(5);
+		}
+		printf("SWEET GPU: GMU SPTPRAC status=0x%08x (%s, &0x38=0x%02x)\n",
+		    sptprac_status,
+		    ((sptprac_status & SPTPRAC_STATUS_MASK) == SPTPRAC_STATUS_READY) ? "READY" : "WAIT/TIMEOUT",
+		    sptprac_status & SPTPRAC_STATUS_MASK);
+	} else {
+		printf("SWEET GPU: GMU map failed\n");
+	}
+
+	/* 8. Enable GFX3D root clock and pulse AON reset */
+	printf("SWEET GPU: force-enabling GFX3D root clock (0x101c)...\n");
+	gpu_wr(gpucc, GPUCC_GX_GFX3D_CMD_RCGR, gpu_rd(gpucc, GPUCC_GX_GFX3D_CMD_RCGR) | RCG_ROOT_EN);
+	delay(20);
+
+	printf("SWEET GPU: pulsing AON logic reset (0x1008)...\n");
+	gpu_wr(gpucc, GPUCC_GX_SW_RESET, 1u);
+	delay(20);
+	gpu_wr(gpucc, GPUCC_GX_SW_RESET, 0u);
+	delay(20);
+
+	/* 9. Power on GX GDSC if needed */
+	gx_gdscr = gpu_rd(gpucc, GPUCC_GPU_GX_GDSCR);
+	if (!(gx_gdscr & (GDSC_PWR_ON | GDSC_PWR_UP_DONE))) {
+		printf("SWEET GPU: powering on GX GDSC (current: 0x%08x)...\n", gx_gdscr);
+		gpu_wr(gpucc, GPUCC_GPU_GX_GDSCR, gx_gdscr & ~GDSC_SW_COLLAPSE);
+		gpu_poll_gdsc_on(gpucc, GPUCC_GPU_GX_GDSCR, "GX");
+	}
+
+	/* 10. Enable GPUCC GFX3D branch clock (BRANCH_HALT_SKIP) */
+	printf("SWEET GPU: enabling GFX3D branch clock...\n");
+	gpu_wr(gpucc, GPUCC_GX_GFX3D_CBCR, CBCR_ENABLE);
+	delay(20);
+
+	final_gx = gpu_rd(gpucc, GPUCC_GPU_GX_GDSCR);
+	final_gfx_clk = gpu_rd(gpucc, GPUCC_GX_GFX3D_CBCR);
+	printf("SWEET GPU: post-power GX GDSC 0x%08x (%s, pwr_up_done=%d), GFX3D CBCR 0x%08x\n",
+	    final_gx, (final_gx & GDSC_PWR_ON) ? "ON" : "OFF",
+	    !!(final_gx & GDSC_PWR_UP_DONE),
+	    final_gfx_clk);
+
+	/* 11. Read Adreno 618 3D Core registers */
+	kgsl = ml_io_map(KGSL_3D0_PA, KGSL_3D0_SIZE);
+	if (kgsl == 0) {
+		printf("SWEET GPU: KGSL 3D map failed\n");
+		return;
+	}
+
+	rbbm_status = gpu_rd(kgsl, A6XX_RBBM_STATUS);
+	rbbm_status3 = gpu_rd(kgsl, A6XX_RBBM_STATUS3);
+	vbif_reset = gpu_rd(kgsl, A6XX_RBBM_VBIF_GX_RESET_STATUS);
+	cp_rb_base = gpu_rd(kgsl, A6XX_CP_RB_BASE);
+
+	printf("SWEET GPU: *** Qualcomm Adreno 618 Hardware Responding! ***\n");
+	printf("SWEET GPU: RBBM_STATUS=0x%08x, STATUS3=0x%08x, VBIF_RESET=0x%08x, CP_RB_BASE=0x%08x\n",
+	    rbbm_status, rbbm_status3, vbif_reset, cp_rb_base);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
