+static int
+rh_lookup_arc(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	unsigned matches = 0;
+	unsigned i = 0, j = 0;
+
+	for (i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		uint32_t entries = 0, aux = 0;
+		unsigned count = 0;
+
+		if (!slave) {
+			break;
+		}
+		if (slave != 3u) {
+			continue;
+		}
+		entries = RH_DB_HEADER + rh_db16(h + 2);
+		aux = RH_DB_HEADER + rh_db16(h + 4);
+		count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed ARC slave header %u\n", i);
+			return EINVAL;
+		}
+		for (j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			uint32_t addr = 0;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			addr = rh_read(rh_db, e + 16);
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: ARC %s addr=0x%08x slave=%u\n", res, addr, slave);
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: ARC %s lookup matches=%u\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static int
+rh_send_arc(uint32_t address, uint32_t level)
+{
+	int chosen = -1;
+	unsigned t = 0, us = 0;
+	uint32_t b = 0, bit = 0, irq_en = 0, cmd = 0, status = 0;
+	bool done = false;
+
+	for (t = 0; t < RH_ACTIVE_N; ++t) {
+		if (rh_free(t)) {
+			chosen = (int)t;
+			break;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS for ARC\n");
+		return EBUSY;
+	}
+	t = (unsigned)chosen;
+	b = t * RH_TCS_STRIDE;
+	bit = 1u << t;
+	irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	rh_poisoned = true;
+	printf("SWEET RPMH: TCS%u ARC addr=0x%08x level=%u\n", t, address, level);
+	cmd = b;
+	if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+	    !rh_sync(cmd + RH_ADDR, address) ||
+	    !rh_sync(cmd + RH_DATA, level)) {
+		return EIO;
+	}
+	if (!rh_sync(b + RH_WAIT, 1) || !rh_sync(b + RH_ENABLE, 1) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	for (us = 0; us < RH_TIMEOUT_US; ++us) {
+		status = rh_read(rh_tcs, b + RH_CMD_STATUS);
+		if (status != 0xffffffffu &&
+		    (status & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done) {
+		printf("SWEET RPMH: ARC timeout addr=0x%08x status=0x%08x\n", address, status);
+		return ETIMEDOUT;
+	}
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("SWEET RPMH: ARC vote complete\n");
+	return 0;
+}
+
+int
+sweet_rpmh_arc_vote(const char *res, uint32_t level)
+{
+	int error = EIO;
+	uint32_t address = 0;
+
+	if (!res || level > 512) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_arc(res, &address);
+	}
+	if (!error) {
+		error = rh_send_arc(address, level);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: arc vote %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
